#ifndef CANONICAL_OP
#error "define CANONICAL_OP(Name) before including canonical-op.def"
#endif

CANONICAL_OP(Unknown)
CANONICAL_OP(S_MOV_B32)
CANONICAL_OP(S_ENDPGM)

// vadd cross-gen PoC coverage (gfx1250 -> gfx942), straight-line vector add.
// SOP2 scalar integer / bitfield / select.
CANONICAL_OP(S_ADD_I32)
CANONICAL_OP(S_AND_B32)
CANONICAL_OP(S_MUL_I32)
CANONICAL_OP(S_BFE_U32)
CANONICAL_OP(S_CSELECT_B32)
// SOPC scalar compare (writes SCC).
CANONICAL_OP(S_CMP_EQ_U32)
// Hardware-register query.
CANONICAL_OP(S_GETREG_B32)
// SMEM scalar kernarg loads.
CANONICAL_OP(S_LOAD_B32)
CANONICAL_OP(S_LOAD_B64)
CANONICAL_OP(S_LOAD_B128)
// VALU compute.
CANONICAL_OP(V_ADD_F32)
CANONICAL_OP(V_MAD_U32)
CANONICAL_OP(V_NOP)
// FLAT/global memory (dword).
CANONICAL_OP(GLOBAL_LOAD_DWORD)
CANONICAL_OP(GLOBAL_STORE_DWORD)
// Scheduling / no-effect ops lifted as no-ops.
CANONICAL_OP(GLOBAL_PREFETCH_B8)
CANONICAL_OP(S_SETREG_IMM32_B32)
CANONICAL_OP(S_CLAUSE)
CANONICAL_OP(S_DELAY_ALU)
CANONICAL_OP(S_WAIT_KMCNT)
CANONICAL_OP(S_WAIT_LOADCNT)
CANONICAL_OP(S_WAIT_XCNT)
